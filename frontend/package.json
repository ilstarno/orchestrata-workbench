{
  "name": "orchestrata-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run fmt && npm run i18n:check && tsc --noEmit && vite build && npm run contracts:check",
    "test": "npm run contracts:check && npm run fmt && npm run test:typecheck && vitest run --config ../frontend_tests/vitest.config.ts",
    "test:typecheck": "tsc --noEmit --project ../frontend_tests/tsconfig.json",
    "test:unit": "vitest run --config ../frontend_tests/vitest.config.ts ../frontend_tests/unit",
    "test:integration": "vitest run --config ../frontend_tests/vitest.config.ts ../frontend_tests/integration",
    "i18n:check": "vitest run --config ../frontend_tests/vitest.config.ts ../frontend_tests/integration/locale-validator.test.ts",
    "fmt": "prettier --check \"src/**/*.{ts,tsx,css,json}\" index.html \"../frontend_tests/{unit,integration}/**/*.{ts,tsx}\" vite.config.ts tsconfig.json package.json .prettierrc.json ../frontend_tests/vitest.config.ts ../frontend_tests/tsconfig.json \"../tooling/**/*.cjs\" \"../frontend_tests/types/**/*.ts\"",
    "fmt:write": "prettier --write \"src/**/*.{ts,tsx,css,json}\" index.html \"../frontend_tests/{unit,integration}/**/*.{ts,tsx}\" vite.config.ts tsconfig.json package.json .prettierrc.json ../frontend_tests/vitest.config.ts ../frontend_tests/tsconfig.json \"../tooling/**/*.cjs\" \"../frontend_tests/types/**/*.ts\"",
    "contracts:check": "node ../tooling/check-contract-boundary.cjs",
    "contracts:split": "node ../tooling/split-generated-contracts.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-table": "^8.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "@tanstack/store": "^0.7.0",
    "lucide-react": "^0.460.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "fflate": "^0.8.3",
    "jsdom": "^31.0.1",
    "prettier": "3.10.1",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "vitest": "4.1.12"
  }
}
